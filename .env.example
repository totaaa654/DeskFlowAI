# Public values only. Copy this file to .env and use values from Supabase
# Project Settings > API. Never add a secret/service-role key to VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use the public anon key instead of a publishable key.
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_REDIRECT_URL=deskflowai://auth/callback

